APP_NAME=OpenScore AI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost
MAX_UPLOAD_MB=50
MAX_DURATION=480
MAX_JOBS=12
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT=1800
# YouTube links/song search (needs yt-dlp + a JS runtime) and Demucs isolation.
ENABLE_ONLINE_SOURCES=1
ENABLE_SEPARATION=1
SEPARATION_THREADS=2
JOB_TTL=3600
# Uvicorn does not auto-read this file; set environment in your shell or use Compose.
# Frontend build variables belong in frontend/.env.local:
# VITE_API_URL=https://api.example.com
# VITE_APP_NAME=OpenScore AI
# VITE_BASE_PATH=/your-github-repo/
