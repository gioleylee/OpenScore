{
  "name": "openscore-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "build:android": "tsc -b && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/android-build.mjs debug",
    "android:release": "npm run android:sync && node scripts/android-build.mjs release",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "jspdf": "4.2.1",
    "lucide-react": "0.468.0",
    "opensheetmusicdisplay": "1.9.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "svg2pdf.js": "2.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "fake-indexeddb": "6.2.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
